 			await linkFile(tempPath, absolutePath);
 		} catch (error) {
-			await throwGuardedCreateFailure(error, absolutePath, createIfAbsent.displayPath, inspectPublicationTarget);
+			// dsh-termux-core (adopted from ErEbusE/dsh-termux, MIT): Android
+			// SELinux forbids hard links in app-private storage, so link() fails
+			// with EACCES/EPERM on f2fs. Fall back to rename() — equally atomic
+			// no-replace — when the failure is a platform link denial; otherwise
+			// preserve the guarded create failure (incl. EEXIST races).
+			const errno = error && error.code !== void 0 ? error.code : void 0;
+			const platformLinkDenied = errno !== void 0 && ["EACCES", "EPERM", "ENOTSUP", "EOPNOTSUPP"].includes(errno);
+			if (platformLinkDenied) try {
+				await rename(tempPath, absolutePath);
+			} catch (renameError) {
+				await throwGuardedCreateFailure(renameError, absolutePath, createIfAbsent.displayPath, inspectPublicationTarget);
+			}
+			else await throwGuardedCreateFailure(error, absolutePath, createIfAbsent.displayPath, inspectPublicationTarget);
 		}

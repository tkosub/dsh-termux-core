# denied by SELinux (EACCES/EPERM/ENOTSUP/EOPNOTSUPP), fall back to an equally
# atomic no-replace rename() for new-file publication.
#
# Derived from ErEbusE/dsh-termux (https://github.com/ErEbusE/dsh-termux),
# file `npm-dsh-fs-local-link-rename.patch`, MIT License,
# Copyright (c) 2026 ErEbusE. Re-derived for @deepseek-ai/dsh-fs-local.
#
# Apply with:  patch -p1 < dsh-fs-local-link-rename.patch
--- a/dsh-fs-local/lib/index.js	2026-09-16 13:40:34.996831951 +0200
+++ b/dsh-fs-local/lib/index.js	2026-09-16 13:40:35.056831957 +0200
@@ -532,7 +532,19 @@

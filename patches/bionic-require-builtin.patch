diff --git a/packages/native/src/runtime_context/linux_android_arm64.cc b/packages/native/src/runtime_context/linux_android_arm64.cc
new file mode 100644
index 0000000..5a7f8b7
--- /dev/null
+++ b/packages/native/src/runtime_context/linux_android_arm64.cc
@@ -0,0 +1,14 @@
+#include "helper.h"
+
+namespace esplus::node::require_builtin {
+
+// Android (bionic) arm64: the context reader is platform-independent — it calls
+// the V8 symbols (exported on Termux) and reads the context. Only the
+// diagnostic platform tag differs.
+Result<CurrentContextRead> ReadLinuxAndroidArm64CurrentV8Context(
+    void* isolate,
+    const CurrentContextSymbols& symbols) {
+  return ReadDirectCurrentV8Context("linux-android-arm64", isolate, symbols);
+}
+
+}  // namespace esplus::node::require_builtin
diff --git a/packages/native/src/runtime_context/platform.cc b/packages/native/src/runtime_context/platform.cc
index c743705..98b7d9b 100644
--- a/packages/native/src/runtime_context/platform.cc
+++ b/packages/native/src/runtime_context/platform.cc
@@ -32,6 +32,8 @@ Result<CurrentContextRead> ReadCurrentV8Context(
   return ReadLinuxGlibcArm64CurrentV8Context(isolate, symbols);
 #elif defined(__linux__) && defined(__GLIBC__) && defined(__x86_64__)
   return ReadLinuxGlibcX64CurrentV8Context(isolate, symbols);
+#elif defined(__linux__) && !defined(__GLIBC__) && defined(__aarch64__)
+  return ReadLinuxAndroidArm64CurrentV8Context(isolate, symbols);
 #elif defined(__linux__)
   return UnsupportedContextReader("unsupported linux libc current-context reader");
 #elif defined(_WIN32) && defined(_M_ARM64)
diff --git a/packages/native/src/runtime_probe/linux_android_arm64.cc b/packages/native/src/runtime_probe/linux_android_arm64.cc
new file mode 100644
index 0000000..a106a22
--- /dev/null
+++ b/packages/native/src/runtime_probe/linux_android_arm64.cc
@@ -0,0 +1,19 @@
+#include "parser.h"
+
+#include "getter_decoder.h"
+#include "helper.h"
+
+namespace esplus::node::require_builtin {
+
+// Android (bionic) arm64: the getter is a 12-byte leaf —
+//   bti c; ldr x0, [x0, #imm]; ret
+// The AAPCS walker already tolerates BTI landing pads and accepts exactly this
+// shape, so it is reused unchanged. The field offset is decoded from the code,
+// not hardcoded, so it adapts if Termux's Node layout changes.
+Result<GetterPattern> ParseLinuxAndroidArm64BuiltinModuleRequireGetterOffset(
+    void* getter) {
+  return DecodeGetterWithWideWindowRetry(getter, "linux-android-arm64",
+                                         MatchArm64AapcsFieldGetter);
+}
+
+}  // namespace esplus::node::require_builtin
